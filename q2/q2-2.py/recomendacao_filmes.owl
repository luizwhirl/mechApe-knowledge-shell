<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://exemplo.org/recomendacao_filmes.owl"
         xmlns="http://exemplo.org/recomendacao_filmes.owl#">

<owl:Ontology rdf:about="http://exemplo.org/recomendacao_filmes.owl"/>

<owl:ObjectProperty rdf:about="#temGenero">
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="#Genero"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dirigidoPor">
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="#Diretor"/>
  <owl:inverseOf rdf:resource="#dirigiu"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#disponivelEm">
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="#Plataforma"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temClassificacao">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="#Publico"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#similarA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="#Obra"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dirigiu">
  <rdfs:domain rdf:resource="#Diretor"/>
  <rdfs:range rdf:resource="#Obra"/>
  <owl:inverseOf rdf:resource="#dirigidoPor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recomendadoApos">
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="#Obra"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#doMesmoDiretorQue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="#Obra"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#temTitulo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#temAno">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#temNota">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#temDuracaoMin">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Filme"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numTemporadas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Serie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomePessoa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Diretor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomePlataforma">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Plataforma"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ehPremiado">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Obra"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Obra">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Filme">
  <rdfs:subClassOf rdf:resource="#Obra"/>
</owl:Class>

<owl:Class rdf:about="#Serie">
  <rdfs:subClassOf rdf:resource="#Obra"/>
</owl:Class>

<owl:Class rdf:about="#Genero">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Acao">
  <rdfs:subClassOf rdf:resource="#Genero"/>
</owl:Class>

<owl:Class rdf:about="#Drama">
  <rdfs:subClassOf rdf:resource="#Genero"/>
</owl:Class>

<owl:Class rdf:about="#Comedia">
  <rdfs:subClassOf rdf:resource="#Genero"/>
</owl:Class>

<owl:Class rdf:about="#FiccaoCientifica">
  <rdfs:subClassOf rdf:resource="#Genero"/>
</owl:Class>

<owl:Class rdf:about="#Terror">
  <rdfs:subClassOf rdf:resource="#Genero"/>
</owl:Class>

<owl:Class rdf:about="#Diretor">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Plataforma">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Publico">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Livre">
  <rdfs:subClassOf rdf:resource="#Publico"/>
</owl:Class>

<owl:Class rdf:about="#Adulto">
  <rdfs:subClassOf rdf:resource="#Publico"/>
</owl:Class>

<owl:Class rdf:about="#ObraAclamada">
  <rdfs:subClassOf rdf:resource="#Obra"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Obra"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temNota"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.5</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FilmeDeAcao">
  <rdfs:subClassOf rdf:resource="#Filme"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Filme"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temGenero"/>
          <owl:someValuesFrom rdf:resource="#Acao"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ObraParaMaratonar">
  <rdfs:subClassOf rdf:resource="#Serie"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Serie"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#numTemporadas"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#RecomendacaoPremium">
  <rdfs:subClassOf rdf:resource="#Obra"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Obra"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#ehPremiado"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temNota"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.5</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#ObraAclamada"/>
</owl:Class>

